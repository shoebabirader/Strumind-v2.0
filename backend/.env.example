# StruMind v2.0 Environment Configuration
# SECURITY: Copy this file to .env and set secure values
# NEVER commit .env file to version control!

# Environment (development, staging, production)
ENVIRONMENT=development

# Database Configuration
# For development (SQLite):
DATABASE_URL=sqlite:///./strumind.db

# For production (PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/strumind_db

# JWT Security (CRITICAL: Generate secure random key for production!)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_VALUE_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=*

# API Configuration
API_TITLE=StruMind API
API_VERSION=2.0.0

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.ifc,.dxf,.dwg,.json

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/strumind.log

# Email Configuration (Optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@strumind.com

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://localhost:6379/0

# Sentry Configuration (Optional - for error tracking)
# SENTRY_DSN=your-sentry-dsn-here
